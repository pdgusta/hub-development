 "nos": [
  {
   "id": "maestro",
   "titulo": "Maestro orquestra",
   "papel": "fora-dos-scripts",
   "detalhe": "plano inteiro em laco-system-design/orquestracao.md; nada começou; você só aprova a direção visual e a troca final"
  },
  {
   "id": "video",
   "titulo": "Colher as skills",
   "papel": "etapa",
   "detalhe": "feito: 258 quadros, dez Haiku 5.5, 8 coleções e perto de 90 skills (skills-do-video.md)"
  },
  {
   "id": "fonte",
   "titulo": "Ler na fonte",
   "papel": "etapa",
   "detalhe": "um Haiku 5.5 por coleção lê repositório, licença, SKILL.md, referências e scripts; uma ficha por skill: o que faz, a description que dispara a skill sozinha, o que precisa para rodar, riscos; nada instalado"
  },
  {
   "id": "categorias",
   "titulo": "Montar categorias",
   "papel": "etapa",
   "detalhe": "um Sonnet 5.5 agrupa as skills pelo que fazem, com nomes tirados do conteúdo; em cada categoria: o que resolve, sobreposições, qual fica e quais disputam o mesmo gatilho"
  },
  {
   "id": "julgar",
   "titulo": "Julgar categorias",
   "papel": "decisao",
   "detalhe": "o maestro confere cobertura, conflito de gatilho, segurança dos scripts e a description de cada skill; reprova com lista de ajustes e volta às categorias"
  },
  {
   "id": "suite",
   "titulo": "Suíte aprovada",
   "papel": "etapa",
   "detalhe": "lista final por categoria e por papel; entra no acervo do maestro para outros visuais e projetos"
  },
  {
   "id": "texto-hub",
   "titulo": "Texto do hub",
   "papel": "etapa",
   "detalhe": "o Tech lead escreve o texto padrão que descreve o hub (peças, papéis, ligações, fluxos, sem implementação), base para qualquer diagrama"
  },
  {
   "id": "conferir-texto",
   "titulo": "Maestro confere o texto",
   "papel": "decisao",
   "detalhe": "cada rodada o maestro confere contra as decisões fechadas e aponta o que falta, sobra ou contradiz; volta ao Tech lead até concordarem"
  },
  {
   "id": "equipe",
   "titulo": "Subir a equipe",
   "papel": "etapa",
   "detalhe": "quatro recrutas com papel no acervo e pasta própria: UI engineer, UX revisor, Tech lead, QA tester; skills da suíte em .claude/skills de cada pasta, invocação autônoma, conferida pelo maestro"
  },
  {
   "id": "regua",
   "titulo": "A régua",
   "papel": "controle",
   "detalhe": "os critérios (linhas sem se cruzar, vista de cima, distância entre itens, nomes claros, cidade com papel para cada item, reinventar a forma) aplicados também por skills da suíte que medem gosto e percepção, como a tastemaker; quais, sai do julgamento das categorias"
  },
  {
   "id": "conceitos",
   "titulo": "Conceitos de cidade",
   "papel": "etapa",
   "detalhe": "o UI engineer faz amostras de direção visual: formas de cidade realmente diferentes, lado a lado atrás de um seletor; só o bastante para mostrar a direção"
  },
  {
   "id": "porta",
   "titulo": "Porta: Tech lead e UX revisor",
   "papel": "decisao",
   "detalhe": "o Tech lead mede a congruência com o texto do hub e o UX revisor a régua; nota por dimensão e consertos; reprovado volta aos conceitos"
  },
  {
   "id": "direcao",
   "titulo": "Você aprova a direção",
   "papel": "decisao",
   "detalhe": "a única parada sua antes de construir: uma carta com os conceitos que passaram e o parecer da porta; escolher, misturar ou recusar todos"
  },
  {
   "id": "amostra",
   "titulo": "Construir a amostra",
   "papel": "etapa",
   "detalhe": "o UI engineer constrói a direção aprovada como amostra inicial, numa página à parte, sem tocar o system-design.html"
  },
  {
   "id": "testar",
   "titulo": "Testar e revisar",
   "papel": "etapa",
   "detalhe": "o QA tester testa larguras, contraste, teclado, links e desempenho; UX revisor e Tech lead revisam; o Prumo revisa o código; sem os três, volta a construir"
  },
  {
   "id": "teto",
   "titulo": "Teto",
   "papel": "controle",
   "detalhe": "voltas máximas de cada laço interno e orçamento de tokens; ao bater, o laço para e espera você"
  },
  {
   "id": "entrega",
   "titulo": "Você vê a amostra",
   "papel": "decisao",
   "detalhe": "a troca do system-design.html, ou a peça inteira a partir da amostra, só com o seu aval"
  }
 ],
