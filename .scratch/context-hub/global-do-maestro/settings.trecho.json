{
  "model": "claude-opus-5-5",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 600000
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "editorMode": "normal",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "%USERPROFILE%\\.claude\\mods\\contexto-agentes;%USERPROFILE%\\.claude\\mods\\guarda-de-recrutas"
  },
  "skillOverrides": {
    "claude-handoff": "off",
    "codebase-design": "off",
    "git-guardrails-claude-code": "off",
    "grill-me": "off",
    "implement-spec": "on",
    "improve-codebase-architecture": "off",
    "loop-me": "off",
    "maestri-portal-devices": "off",
    "migrate-to-shoehorn": "off",
    "pr": "off",
    "retro": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "setup-ts-deep-modules": "off",
    "teach": "off",
    "to-questionnaire": "off",
    "triage": "off",
    "wait-what": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-shape": "off"
  }
}